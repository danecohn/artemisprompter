{
  "name": "artemis-prompter",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Artemis Softworks LLC",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/view": "6.43.15",
    "@codemirror/state": "6.7.6",
    "@codemirror/commands": "6.11.1",
    "codemirror": "6.0.2",
    "marked": "18.1.1",
    "dompurify": "3.4.17",
    "yaml": "2.9.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2"
  },
  "productName": "Artemis Prompter",
  "description": "Write connected prompts and export readable AI-ready bundles.",
  "homepage": "https://github.com/danecohn/artemisprompter",
  "build": {
    "appId": "com.artemissoftworks.prompter",
    "productName": "Artemis Prompter",
    "copyright": "Copyright \u00a9 2026 Artemis Softworks LLC",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "core/**",
      "dist/**",
      "assets/**",
      "package.json",
      "product.json",
      "LICENSE",
      "README.md",
      "NOTICE.md"
    ],
    "artifactName": "ArtemisPrompter-${os}-${arch}.${ext}",
    "afterPack": "scripts/adhoc-sign.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "maintainer": "Artemis Softworks LLC"
    }
  }
}
